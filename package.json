{
  "name": "autobones",
  "version": "0.1.0",
  "description": "Auto-layout skeleton loaders that measure your real UI. Works with React, Vue, Svelte, Web Components and plain JS.",
  "license": "MIT",
  "author": {
    "name": "Drinor Shabiu",
    "url": "https://github.com/Drinor101"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drinor101/autobones.git"
  },
  "homepage": "https://autobones.netlify.app",
  "bugs": {
    "url": "https://github.com/Drinor101/autobones/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/element.*"
  ],
  "files": [
    "dist",
    "style.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "svelte": [
        "./dist/svelte.d.ts"
      ],
      "element": [
        "./dist/element.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/write-css.mjs && node scripts/use-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && npx serve .",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "skeleton",
    "loader",
    "loading",
    "placeholder",
    "shimmer",
    "react",
    "vue",
    "svelte",
    "web-component"
  ],
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.2",
    "svelte": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vue": "^3.5.0"
  }
}
